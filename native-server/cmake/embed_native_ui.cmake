if (NOT DEFINED UI_DIRECTORY OR NOT DEFINED OUTPUT_FILE)
  message(FATAL_ERROR "UI_DIRECTORY and OUTPUT_FILE are required")
endif()

file(GLOB_RECURSE ui_files LIST_DIRECTORIES FALSE "${UI_DIRECTORY}/*")
list(SORT ui_files)
list(LENGTH ui_files ui_count)
file(WRITE "${OUTPUT_FILE}" "static constexpr std::array<EmbeddedUiAsset, ${ui_count}> embedded_ui_assets{{\n")

set(index 0)
foreach(ui_file IN LISTS ui_files)
  file(RELATIVE_PATH relative_path "${UI_DIRECTORY}" "${ui_file}")
  file(TO_CMAKE_PATH "${relative_path}" relative_path)
  if (relative_path MATCHES "(^|/)\\.\\.?(/|$)" OR NOT relative_path MATCHES "^[A-Za-z0-9._/-]+$")
    message(FATAL_ERROR "Unsupported Native UI asset path: ${relative_path}")
  endif()
  file(READ "${ui_file}" content)
  file(SIZE "${ui_file}" content_size)
  set(delimiter "PMUI${index}")
  set(terminator ")${delimiter}\"")
  string(FIND "${content}" "${terminator}" collision)
  while (NOT collision EQUAL -1)
    math(EXPR index "${index} + 1")
    set(delimiter "PMUI${index}")
    set(terminator ")${delimiter}\"")
    string(FIND "${content}" "${terminator}" collision)
  endwhile()
  file(APPEND "${OUTPUT_FILE}" "  {\"${relative_path}\", std::string_view(R\"${delimiter}(${content})${delimiter}\", ${content_size})},\n")
  math(EXPR index "${index} + 1")
endforeach()

file(APPEND "${OUTPUT_FILE}" "}};\n")
