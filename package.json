{
  "name": "plugin-platform",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "bash scripts/deploy-worker.sh",
    "native-ui:build": "tsc -p native-ui/tsconfig.json && vite build --config native-ui/vite.config.ts",
    "native-ui:smoke": "npm run native-ui:build && cmake -S native-server -B native-server/build && cmake --build native-server/build --target plugmesh-local-ui-smoke-server && playwright test --config native-ui/playwright.config.ts",
    "worker:response-validation-smoke": "node --experimental-strip-types worker/response-validation.smoke.ts",
    "worker:request-mode-smoke": "node --experimental-strip-types worker/request-mode.smoke.ts",
    "worker:manifest-smoke": "node --experimental-strip-types worker/manifest.smoke.ts",
    "worker:wrangler-config-smoke": "node --experimental-strip-types worker/wrangler-config.smoke.ts",
    "worker:plugin-restore-smoke": "esbuild worker/plugin-restore.smoke.ts --bundle --platform=node --format=esm --outfile=/tmp/plugmesh-plugin-restore-smoke.mjs && node /tmp/plugmesh-plugin-restore-smoke.mjs",
    "worker:public-route-smoke": "esbuild worker/public-route.smoke.ts --bundle --platform=node --format=esm --outfile=/tmp/plugmesh-public-route-smoke.mjs && node /tmp/plugmesh-public-route-smoke.mjs",
    "worker:route-cache-smoke": "esbuild worker/route-cache.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-route-cache-smoke.mjs && node /tmp/plugmesh-route-cache-smoke.mjs",
    "worker:public-proxy-smoke": "esbuild worker/public-proxy.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-public-proxy-smoke.mjs && node /tmp/plugmesh-public-proxy-smoke.mjs",
    "worker:api-permission-smoke": "esbuild worker/api-permission.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-api-permission-smoke.mjs && node /tmp/plugmesh-api-permission-smoke.mjs",
    "worker:cloudflare-usage-smoke": "esbuild worker/cloudflare-usage.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-cloudflare-usage-smoke.mjs && node /tmp/plugmesh-cloudflare-usage-smoke.mjs",
    "worker:local-usage-smoke": "esbuild worker/local-usage.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-local-usage-smoke.mjs && node /tmp/plugmesh-local-usage-smoke.mjs",
    "worker:smtp-settings-smoke": "esbuild worker/smtp-settings.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-smtp-settings-smoke.mjs && node /tmp/plugmesh-smtp-settings-smoke.mjs",
    "worker:maintenance-email-smoke": "esbuild worker/maintenance-email.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-maintenance-email-smoke.mjs && node /tmp/plugmesh-maintenance-email-smoke.mjs",
    "worker:scheduled-maintenance-smoke": "esbuild worker/scheduled-maintenance.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-scheduled-maintenance-smoke.mjs && node /tmp/plugmesh-scheduled-maintenance-smoke.mjs",
    "worker:server-sync-smoke": "esbuild worker/server-sync.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-server-sync-smoke.mjs && node /tmp/plugmesh-server-sync-smoke.mjs",
    "worker:registration-race-smoke": "esbuild worker/registration-race.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-registration-race-smoke.mjs && node /tmp/plugmesh-registration-race-smoke.mjs",
    "worker:server-binding-smoke": "esbuild worker/server-binding.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-server-binding-smoke.mjs && node /tmp/plugmesh-server-binding-smoke.mjs",
    "worker:durable-object-sync-smoke": "esbuild worker/durable-object-sync.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-durable-object-sync-smoke.mjs && node /tmp/plugmesh-durable-object-sync-smoke.mjs",
    "worker:durable-object-lifecycle-smoke": "esbuild worker/durable-object-lifecycle.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-durable-object-lifecycle-smoke.mjs && node /tmp/plugmesh-durable-object-lifecycle-smoke.mjs",
    "worker:durable-object-stream-smoke": "esbuild worker/durable-object-stream.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-durable-object-stream-smoke.mjs && node /tmp/plugmesh-durable-object-stream-smoke.mjs",
    "worker:blob-stream-smoke": "esbuild worker/blob-stream.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-blob-stream-smoke.mjs && node /tmp/plugmesh-blob-stream-smoke.mjs",
    "worker:blob-expiry-smoke": "esbuild worker/blob-expiry.smoke.ts --bundle --platform=node --format=esm --external:cloudflare:sockets --outfile=/tmp/plugmesh-blob-expiry-smoke.mjs && node /tmp/plugmesh-blob-expiry-smoke.mjs",
    "worker:smoke": "npm run worker:response-validation-smoke && npm run worker:request-mode-smoke && npm run worker:manifest-smoke && npm run worker:wrangler-config-smoke && npm run worker:plugin-restore-smoke && npm run worker:public-route-smoke && npm run worker:route-cache-smoke && npm run worker:public-proxy-smoke && npm run worker:api-permission-smoke && npm run worker:cloudflare-usage-smoke && npm run worker:local-usage-smoke && npm run worker:smtp-settings-smoke && npm run worker:maintenance-email-smoke && npm run worker:scheduled-maintenance-smoke && npm run worker:server-sync-smoke && npm run worker:registration-race-smoke && npm run worker:server-binding-smoke && npm run worker:durable-object-sync-smoke && npm run worker:durable-object-lifecycle-smoke && npm run worker:durable-object-stream-smoke && npm run worker:blob-stream-smoke && npm run worker:blob-expiry-smoke",
    "ui:smoke": "playwright test --config playwright.config.ts",
    "ui:real-stack": "playwright test --config playwright.real-stack.config.ts",
    "preview": "vite preview",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:runtime-test": "vitest run --config vitest.workers.config.ts",
    "worker:dev": "wrangler dev --config wrangler.toml",
    "deploy:worker": "bash scripts/deploy-worker.sh",
    "deploy:worker:test": "bash scripts/deploy-worker.test.sh",
    "release:workflow:test": "bash scripts/release-workflow.test.sh",
    "native-ui:smoke:wine": "bash native-ui/run-wine-smoke.sh",
    "stack:load": "playwright test --config playwright.load.config.ts",
    "stack:streams": "playwright test --config playwright.streams.config.ts",
    "stack:maintenance": "playwright test --config playwright.maintenance.config.ts",
    "stack:restart": "playwright test --config playwright.restart.config.ts",
    "stack:multi-isolate": "playwright test --config playwright.multi-isolate.config.ts",
    "stack:browser": "playwright test --config playwright.browser.config.ts",
    "ui:conventions": "node scripts/ui-conventions.mjs",
    "ui:css-audit": "node scripts/ui-css-audit.mjs",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "antd": "^5.29.3",
    "i18next": "^26.5.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "vite": "latest",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.55.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.1",
    "mailparser": "^3.10.0",
    "smtp-server": "^3.20.2",
    "typescript": "latest",
    "vitest": "^4.1.0",
    "wrangler": "latest",
    "ws": "^8.21.0"
  }
}
